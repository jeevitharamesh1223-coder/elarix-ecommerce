# ELARIX Backend Environment Variables
NODE_ENV=production
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration
# Option A: Supabase Free PostgreSQL (Recommended for cloud deployment)
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Option B: SQLite (Default when DATABASE_URL is not provided)
# SQLITE_STORAGE_PATH=/var/data/elarix.sqlite

# Persistent Cloud Object Storage (Supabase Storage for free persistent product images)
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
# SUPABASE_STORAGE_BUCKET=elarix-uploads

# Local Disk Uploads Directory (Fallback when cloud storage is not configured)
# UPLOADS_DIR=/var/data/uploads
# BACKUP_DIR=/var/data/backups

# Allowed origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://elarix.yourdomain.com

# Initial Production Administrator (Used only on clean database first-boot auto-seed)
ADMIN_EMAIL=admin@elarix.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Key required to register additional admins via API
ADMIN_SETUP_KEY=your_secure_admin_setup_passphrase_here

# Payment Provider Configuration (Optional for Online Card Payments)
# If STRIPE_SECRET_KEY is omitted, Cash on Delivery remains the active, safe payment workflow.
# STRIPE_SECRET_KEY=sk_test_51...
# STRIPE_PUBLISHABLE_KEY=pk_test_51...
# STRIPE_WEBHOOK_SECRET=whsec_...
